{
  "name": "blue-ledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "react-router dev",
    "dev:api": "tsx watch src/server/main.ts",
    "build": "tsc -b && react-router build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "typegen": "react-router typegen",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@hono/node-server": "^1.19.9",
    "@react-router/node": "^7.14.0",
    "clsx": "^2.1.1",
    "hono": "^4.11.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.14.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.21.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-router/dev": "^7.14.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
